#!/usr/bin/env bash
#
# flash — erase the Ulanzi TC001 over USB and write an AWTRIX NG USB image.
#
# Downloads the release's usb-awtrix-ng.zip, extracts the 4 MB classic-ESP32
# image the TC001 needs, erases the chip and writes the image at 0x0. Wi-Fi
# and every setting are gone afterwards; `./apply --host 192.168.4.1 --wifi`
# provisions the blank clock from the setup access point.
#
# Usage:
#   ./flash                          latest release, auto-detected serial port
#   ./flash --version v1.1.1         a specific release tag
#   ./flash --port /dev/cu.usbserial-201130
#   ./flash --baud 115200            serial speed for erase and write
#
# Requires: uvx (runs esptool), curl, unzip, a USB *data* cable.

set -euo pipefail

readonly REPO="Blueforcer/awtrix-ng"
readonly IMAGE="usb-awtrix-ng-4mb.bin"

main() {
  local version="" port="" baud="115200"
  while [ $# -gt 0 ]; do
    case $1 in
    --version) version=${2?$1: parameter value not set} && shift 2 ;;
    --version=*) version=${1#*=} && shift ;;
    --port) port=${2?$1: parameter value not set} && shift 2 ;;
    --port=*) port=${1#*=} && shift ;;
    --baud) baud=${2?$1: parameter value not set} && shift 2 ;;
    --baud=*) baud=${1#*=} && shift ;;
    *) die "unknown parameter: $1" ;;
    esac
  done

  [ -n "$version" ] || version=$(latest_version)
  [ -n "$port" ] || port=$(detect_port)

  local work
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT

  log task "downloading $REPO $version"
  curl -fsSL -o "$work/usb.zip" \
    "https://github.com/$REPO/releases/download/$version/usb-awtrix-ng.zip"
  unzip -q -o "$work/usb.zip" "$IMAGE" -d "$work"
  log ok "$IMAGE ($(stat -f%z "$work/$IMAGE") bytes)"

  log task "erasing flash on $port"
  uvx esptool --chip esp32 --port "$port" --baud "$baud" erase-flash >/dev/null \
    || die "erase failed; check the cable and that nothing else holds $port"
  log ok "flash erased"

  log task "writing $IMAGE at 0x0 (about two minutes at $baud baud)"
  uvx esptool --chip esp32 --port "$port" --baud "$baud" write-flash 0x0 "$work/$IMAGE" \
    | grep -E "Wrote|Hash" || die "esptool did not confirm the write"
  log ok "AWTRIX NG $version written and verified"

  log info "the clock now opens an open Wi-Fi network named awtrixng-<id>; join it, then run:"
  log info "  ./apply --host 192.168.4.1 --wifi"
}

latest_version() {
  curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" \
    | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p'
}

detect_port() {
  local ports=(/dev/cu.usbserial-*)
  [ -e "${ports[0]}" ] || die "no /dev/cu.usbserial-* port; is the clock connected with a data cable?"
  [ "${#ports[@]}" -eq 1 ] || die "several serial ports found, pass --port: ${ports[*]}"
  printf '%s\n' "${ports[0]}"
}

log() {
  local kind=$1 && shift
  local icon color
  case $kind in
  ok) icon='✔' && color=$(tput setaf 2) ;;
  task) icon='⚙' && color=$(tput setaf 3) ;;
  info) icon='ℹ' && color=$(tput setaf 7) ;;
  err) icon='✘' && color=$(tput setaf 1) ;;
  esac
  printf '%s%s%s %s\n' "$color" "$icon" "$(tput sgr0)" "$*"
}

die() {
  log err "$*" >&2
  exit 1
}

main "$@"
