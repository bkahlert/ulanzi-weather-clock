# @module
# @desc The clock's wipe sprites: {"cast": name -> [frames as one string, palette, opacities per frame as bytes, width, frame timing in 10 ms as bytes or nil], "roster": the names in the header's order}. A palette is [letters, colours as bytes, four little-endian per letter]; a letter is its colour (0xAARRGGBB: translucent, AA its opacity in 60ths), a digit a transparent pixel's class and the byte at that index of the frame's bytes its opacity in 60ths. Generated by sprites/extract, do not edit.
# the shared palette: every sprite but kitt and the beam draws from it
var palette = ["abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLM", bytes("")]
# mario: 16x8, 6 frames
var mario = ["",
 palette,
 [bytes("3C2D1E0F00"), bytes("3C2D1E0F00"), bytes("3C1E00"), bytes("3C2D1E0F00"), bytes("3C32281E140A00"), bytes("3C3024180C00")],
 16, nil]
# chase: 17x8, 4 frames
