return {"cast": {"mario": mario, "chase": chase, "invader": invader, "beam": beam, "yoshi": yoshi, "sonic": sonic, "lemming": lemming, "kitt": kitt, "metroid": metroid}, "roster": ["mario", "chase", "invader", "beam", "yoshi", "sonic", "lemming", "kitt", "metroid"]}
