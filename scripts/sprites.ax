 palette,
 [bytes("3C2D1E0F00"), bytes("3C2D1E0F00"), bytes("3C2D1E0F00"), bytes("3C2D1E0F00")],
 17, nil]
# invader: 8x8, 2 frames
var invader = ["000mm77700mmmm770mmmmmm7mmnmmnmmmmmmmmmm00m33m770m2mm5m7m1m44m6m000mm22200mmmm220mmmmmm2mmnmmnmmmmmmmmmm0m1mm1m2m111111m0m1111m2",
 palette,
 [bytes("3C332B221A110900"), bytes("3C1E00")],
 8, bytes("2424")]
# beam: 3x8, 1 frames
var beam = ["abWabWabWabWabWabWabWabW",
 ["abW", bytes("FFFFFF0FFFFFFF1EFFFFFF00")],
 [bytes("3C00")],
 3, nil]
# yoshi: 8x8, 5 frames
var yoshi = ["",
 palette,
 [bytes("3C281400"), bytes("3C281400"), bytes("3C1E00"), bytes("3C1E00"), bytes("3C1E00")],
 8, bytes("2121212121")]
# sonic: 8x8, 6 frames
var sonic = ["",
 palette,
 [bytes("3C281400"), bytes("3C281400"), bytes("3C2D1E0F00"), bytes("3C281400"), bytes("3C2D1E0F00"), bytes("3C281400")],
 8, bytes("0A0A0A0A0A0A")]
# lemming: 8x8, 4 frames
var lemming = ["00IIG111000GGG11000GH111000GH111000GH111000HH11100GHH111000GG11100III222000IG222000GGG2200GGH22200GHH2220GGHHH2200HHHH220GG11GG200IIG11100IGGG11000GH111000HG111000GH111000HH11100GHH111000GG11100III222000IG222000GGG22000HG222000HG222000HHG2200HHHH220GG11GG2",
 palette,
 [bytes("3C00"), bytes("3C1E00"), bytes("3C00"), bytes("3C1E00")],
 8, bytes("10101010")]
# kitt: 4x8, 1 frames
var kitt = ["abcdefghijklmnopqrstuvwxyzABCDEF",
 ["abcdefghijklmnopqrstuvwxyzABCDEF", bytes("F600AC0FF600AC1EF600AC2DF600AC00F614000FF614001EF614002DF6140000F6F6000FF6F6001EF6F6002DF6F600009CF6000F9CF6001E9CF6002D9CF6000000F6310F00F6311E00F6312D00F6310000F6F60F00F6F61E00F6F62D00F6F6000085F60F0085F61E0085F62D0085F6000000F60F0000F61E0000F62D0000F600")],
 [bytes("3C00")],
 4, nil]
# metroid: 8x8, 2 frames
var metroid = ["00JJJJ220JKKKKJ2JKLKKLKJJKKLLKKJJKKKKKKJ0JJJJJJ20M1MM1M20M1111M200JJJJ440JKKKKJ4JKLKKLKJJKKLLKKJJKKKKKKJ0JJJJJJ400M22M440M1MM3M4",
 palette,
 [bytes("3C1E00"), bytes("3C2D1E0F00")],
