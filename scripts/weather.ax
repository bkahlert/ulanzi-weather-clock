# @module
# @desc The clock's weather: the Open-Meteo fetch, the Hub script's colour ramp, and the page - a 16x8 animated scene from the art module's elements; muted design: dimmed to a backdrop with the temperature full-size on top; classic: bright, the temperature at the right. Returns the class.
import string
import art

class Weather
  # colour stops, label (digits; unit_f: Fahrenheit, else degrees), its colour, WMO code, day flag,
  # fetch state; anim is the classic scene's step in ms, pct the backdrop's brightness in percent
  var st, label, unit_f, classic_label, tcol, code, isday, ticks, age, traw, busy, period, anim, pct, muted
  # the scene's last column + 1 (muted 14, classic 16) and its paces in ms: drift for clouds, mist,
  # sway and stars, fall for rain, snow for flakes - classic: anim for all three
  var clip, drift_ms, fall_ms, snow_ms
  # scene art: rows of palette letters, "." transparent; dpal and dc are the palette and the
  # scene's other colours at the backdrop's brightness
  var wpal, dpal, dc, sun, cloud, storm, flash, back, moon, bolt, fog, stars_at

  # store is the clock's: this runs under the app that made the instance
  def init()
    self.st = [-12, 0xD977DF, -6, 0x9545BC, -1, 0x4B379C, 0, 0xFEC4FF,
               4, 0x31B8DB, 10, 0x31DB8B, 15, 0x6ED228, 21, 0xFFFF28,
               27, 0xF87E27, 32, 0xCF3927, 38, 0xA12527]
    # -- art: generated by art/generate, do not edit --
    self.wpal = art["wpal"]
    self.sun = art["sun"]
    self.moon = art["moon"]
    self.cloud = art["cloud"]
    self.storm = art["storm"]
    self.flash = art["flash"]
    self.fog = art["fog"]
    self.back = art["back"]
    self.bolt = art["bolt"]
    # -- end art --
    self.stars_at = [1, 1, 11, 0, 13, 2, 12, 5, 0, 6, 9, 7]
    self.traw = store.get("temp")
    self.label = self.traw == nil ? nil : self.label_for(self.traw)
    self.tcol = store.get("col", 0x666666)
    self.code = store.get("code", -1)
    self.isday = store.get("isday", true)
    self.ticks = 0
    self.age = 9999
    self.busy = false
    self.reload()
  end

  def reload()
    self.period = int(store.get("every")) * 60
    self.anim = int(store.get("anim"))
    self.muted = store.get("design") == "muted"
    self.drift_ms = self.muted ? 1500 : self.anim
    self.fall_ms = self.muted ? 600 : self.anim
    self.snow_ms = self.muted ? 1200 : self.anim
    self.clip = self.muted ? 14 : 16
    var pct = self.muted ? int(store.get("backdrop")) : 100
    if pct != self.pct
      self.pct = pct
      self.dpal = {}
      for k : self.wpal.keys() self.dpal[k] = self.shade(self.wpal[k]) end
      self.dc = {"drizzle": self.shade(0x2C60B0), "rain": self.shade(0x3C8CFF), "white": self.shade(0xFFFFFF),
                 "star": self.shade(0x505050), "mist": self.shade(0x8C8C94), "edge": self.shade(0x5A5A64)}
    end
    if self.traw != nil self.label = self.label_for(self.traw) end
  end

  # a scene colour at the backdrop's brightness
  def shade(c)
    var p = self.pct
    return rgb(c / 65536 % 256 * p / 100, c / 256 % 256 * p / 100, c % 256 * p / 100)
  end

  # once a second from the app's loop(): age the data, fetch when due
  def tick()
    self.age += 1
    if self.ticks <= 0 && !self.busy
      self.ticks = self.period
      self.busy = true
      http.get("http://api.open-meteo.com/v1/forecast" +
               "?latitude=" + str(store.get("lat")) +
               "&longitude=" + str(store.get("lon")) +
               "&current=temperature_2m,weather_code,is_day&timeformat=unixtime",
               / b, st -> self.on_body(b, st),
               {'find': "\"current\":", 'keep': 300})
    end
    self.ticks -= 1
  end

  # the temperature as digits; both pages draw the degree mark themselves (muted one pixel,
  # classic a 2x2 block); Fahrenheit: muted an F glyph, classic classic_label, digits and F in one run
  def label_for(t)
    self.unit_f = store.get("unit") == "F"
    var v = self.unit_f ? t * 1.8 + 32 : t
    var s = str(int(v + (v >= 0 ? 0.5 : -0.5)))
    self.classic_label = s + "F"
    return s
  end

  def on_body(w, status)
    self.busy = false
    if w == nil return end
    var m = re.search("_2m\":([-0-9.]+)", w)
    var c = re.search("code\":(\\d+)", w)
    var dy = re.search("is_day\":(\\d)", w)
    if m == nil || c == nil return end
    var t = num(m[1])
    if t == nil return end
    self.traw = t
    self.tcol = self.colour(t)
    self.label = self.label_for(t)
    self.code = int(num(c[1]))
    self.isday = dy == nil || dy[1] != "0"
    self.age = 0
    store.set("temp", self.traw)
    store.set("col", self.tcol)
    store.set("code", self.code)
    store.set("isday", self.isday)
  end

  # the Hub script's ramp: interpolated between the stops in self.st
  def colour(v)
    var s = self.st
    if v <= s[0] return s[1] end
    var j = 0
    while j < 20 && v >= s[j + 2]
      j += 2
    end
    if j >= 20 return s[21] end
    var a = s[j + 1]
    var b = s[j + 3]
    var f = (v - s[j]) * 1.0 / (s[j + 2] - s[j])
    return rgb(int(a / 65536 % 256 + (b / 65536 % 256 - a / 65536 % 256) * f),
               int(a / 256 % 256 + (b / 256 % 256 - a / 256 % 256) * f),
               int(a % 256 + (b % 256 - a % 256) * f))
  end

  # The page. Muted: the scene dimmed to a backdrop over columns 0-13, the temperature
  # full-size where the calendar card has its day - rows 2-6, centred on the card's columns
  # 3-11 - with its unit: one pixel for degrees beside the digits' top row; Fahrenheit an F
  # while the label has two characters, since three plus the F would not fit before the time.
  # Whatever would pass column 13 is shifted left to end there. The app draws the time over it
  # afterwards. Classic: the scene bright, the temperature with its unit centred over columns
  # 17-31 - Fahrenheit digits and F in one run, degrees a 2x2 block one column after the digits
  # on rows 2-3 (the firmware's font draws the degree sign as a 3x3 ring, so it is never passed
  # to text()). Both: a red dot top right when the data is stale. t is a draw target (targets module).
  def page(t)
    self.scene(t)
    if !self.muted
      if self.label == nil
        self.run(6, "...", 0x666666, t, 7)
      else
        var s = self.unit_f ? self.classic_label : self.label
        var w = text_ink_width(s) + (self.unit_f ? 0 : 3)
        var x = 17 + (15 - w) / 2
        self.run(x, s, self.tcol, t, 7)
        if !self.unit_f t.rect(x + w - 2, 2, 2, 2, self.tcol) end
      end
    elif self.label == nil
      self.run(5, "...", 0x666666, t, 7)
    else
      var w = text_width(self.label) - 1
      var f = self.unit_f && w <= 7
      if f w += 4 end
      var x = 3 + (9 - w) / 2
      var last = x + w - 1 + (f ? 0 : 2)
      if last > 13 x -= last - 13 end
      self.run(x, self.label, self.tcol, t, 7)
      if f
        t.glyph(x + w - 3, "F", self.tcol, 7)
      else
        t.dot(x + w + 1, 2, self.tcol)
      end
    end
    if self.age > 1200 t.dot(31, 0, 0xFF0000) end
  end

  # the scene ends at the clip column (13 muted, 15 classic); a cloud passing through is cut there, not at the sun
  def stamp(rows, x, y, t)
    var r = 0
    var nr = size(rows)
    while r < nr
      var row = rows[r]
      var k = 0
      var w = size(row)
      while k < w
        var ch = row[k]
        if ch != "." && x + k < self.clip t.dot(x + k, y + r, self.dpal[ch]) end
        k += 1
      end
      r += 1
    end
  end

  # a mist line with softer ends
  def mist(x, y, w, t)
    t.dot(x, y, self.dc["edge"])
    t.rect(x + 1, y, w - 2, 1, self.dc["mist"])
    t.dot(x + w - 1, y, self.dc["edge"])
  end

  # n drops from x0 every dx columns, falling through rows 4..7, neighbours out of phase
  def drops(x0, dx, n, step, col, tall, t)
    var i = 0
    while i < n
      var y = 4 + (step + i * 2) % 4
      t.dot(x0 + i * dx, y, col)
      if tall && y < 7 t.dot(x0 + i * dx, y + 1, col) end
      i += 1
    end
  end

  # 0..amp..0, one step per call
  def sway(step, amp)
    var d = step % (2 * amp)
    return d > amp ? 2 * amp - d : d
  end

  def stars(step, t)
    var at = self.stars_at
    var i = 0
    while i < 12
      t.dot(at[i], at[i + 1], (step + i / 2) % 4 == 0 ? self.dc["star"] : self.dc["white"])
      i += 2
    end
  end

  # WMO weather codes as Open-Meteo reports them. Classic: every motion advances each anim ms
  # (250 by default), the sun's ring breathes - dark, faint, bright, faint, two steps each -
  # lightning flashes white. Muted: each motion at its own pace, the sun stands with its bright
  # ring, the bolt stands, and the storm cloud brightens for
  # 300 ms every 10 s in place of the flash - a strike is the kind of event this design avoids.
  # The muted bolt hangs from the cloud's left edge, clear of the temperature standing over the middle.
  def scene(t)
    var k = self.code
    if k < 0 return end
    var now = now_ms()
    var step = now / self.drift_ms
    var fall = now / self.fall_ms
    var ring = (step / 2) % 4
    var sun = self.sun[self.muted ? 2 : (ring == 3 ? 1 : ring)]
    if k <= 1                                   # clear
      if self.isday
        self.stamp(sun, 4, 0, t)
      else
        self.stamp(self.moon, 4, 0, t)
        self.stars(step, t)
      end
    elif k == 2                                 # partly cloudy
      if self.isday
        self.stamp(sun, 0, 0, t)
      else
        self.stamp(self.moon, 0, 0, t)
        self.stars(step, t)
      end
      self.stamp(self.cloud, 16 - step % 27, 4, t)         # comes in from the right, passes in front, leaves left
    elif k == 3                                 # overcast: a dark cloud behind, up right; the big one in front
      self.stamp(self.back, 8 + self.sway(step / 3, 2), 0, t)
      self.stamp(self.cloud, 2 - self.sway(step / 2, 2), 3, t)
    elif k <= 48                                # fog: the cloud, then two mist lines with a dark row above each
      self.stamp(self.fog, 3, 0, t)
      self.mist(1 + (step / 2) % 3, 5, 9, t)
      self.mist(5 - (step / 3) % 3, 7, 9, t)
    elif k <= 57                                # drizzle
      self.stamp(self.cloud, 3, 0, t)
      self.drops(4, 3, 3, fall, self.dc["drizzle"], false, t)
    elif k <= 67                                # rain
      self.stamp(self.cloud, 3, 0, t)
      self.drops(4, 3, 3, fall, self.dc["rain"], true, t)
    elif k <= 77 || k == 85 || k == 86          # snow
      self.stamp(self.cloud, 3, 0, t)
      var flake = now / self.snow_ms
      var i = 0
      while i < 3
        t.dot(4 + i * 3 + ((flake + i) / 2) % 2, 4 + (flake + i) % 4, self.dc["white"])
        i += 1
      end
    elif k <= 82                                # showers
      self.stamp(self.isday ? sun : self.moon, 0, 0, t)
      self.stamp(self.cloud, 5, 0, t)
      self.drops(7, 3, 3, fall, self.dc["rain"], false, t)
    else                                        # thunderstorm
      var t8 = step % 8
      var strike = self.muted ? now % 10000 < 300 : t8 == 4
      self.stamp(strike ? (self.muted ? self.cloud : self.flash) : self.storm, 3, 0, t)
      self.drops(4, 7, 2, fall, self.dc["rain"], true, t)
      if self.muted || t8 == 4 || t8 == 5 self.stamp(self.bolt, self.muted ? 0 : 6, 4, t) end
    end
  end

  # A string glyph by glyph on the baseline `base`, so a wipe can cut it at a column.
  def run(x, s, col, t, base)
    var i = 0
    var n = size(s)
    while i < n
      var ch = s[i]
      if string.byte(ch) >= 0xC0
        ch = s[i..i + 1]
        i += 1
      end
      t.glyph(x, ch, col, base)
      x += text_width(ch)
      i += 1
    end
  end
end

return Weather
