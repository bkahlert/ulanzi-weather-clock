# Copy to .env (gitignored). The clock's address and web UI login; Wi-Fi only for --wifi after a flash.
ULANZI_IP=192.168.1.50
ULANZI_USER=admin
ULANZI_PASSWORD=change-me
WIFI_SSID=
WIFI_PASSWORD=
# Hub connection key from https://awtrix.de/account/settings; not read by apply, used by hand for icon downloads (docs/operations.md)
AWTRIX_HUB_TOKEN=
