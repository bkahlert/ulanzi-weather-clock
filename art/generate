#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pillow"]
# ///
"""The weather scene assets of ../scripts/clock.ax and how each is built.

A few assets - sun, moon, cloud, bolt - become the elements scene() composes: the sun from a
disc alone, with a faint and with a brighter ring of eight aura pixels, the moon from a disc with a second disc taken out, the clouds from one
silhouette (the Hub icon "cloud", awtrix.de/icons/cloud) that is stretched for the wide
cloud and tinted for storm, flash, fog and the dark cloud behind the overcast one. Every
element is written as rows of palette letters ('.' transparent), the form scene() stamps.

The elements, their palette and the glyph font go to the clock as a script module,
../scripts/art.ax, that returns one map; the weather module (../scripts/weather.ax) imports
it and copies the elements between its art markers, so the drawing code and the data compile
in blocks of their own (see the README's heap tripwire). `art/generate` writes
art/preview.png (every element, enlarged) and prints the module; `art/generate --write`
also writes ../scripts/art.ax and the block in weather.ax.

Coordinates are pixel units from the element's top-left corner. A pixel is lit when its
centre lies inside the shape, so a disc of radius 2.5 about (2.5, 2.5) is the 5x5 circle
with rows 3, 5, 5, 5, 3 wide.
"""
import sys
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

HERE = Path(__file__).resolve().parent
SCRIPT = HERE.parent / "scripts" / "weather.ax"
MODULE = HERE.parent / "scripts" / "art.ax"
PREVIEW = HERE / "preview.png"
BEGIN, END = "    # -- art: generated by art/generate, do not edit --", "    # -- end art --"

PALETTE = {"Y": 0xFFC800, "L": 0xE0E0E8, "M": 0x9898A8, "D": 0x505060,
           "E": 0x707084, "W": 0xFFFFFF, "P": 0xE8E8B0, "Z": 0xFFE000, "G": 0x8C8C94, "g": 0x5A5A64, "A": 0x8C6E00, "a": 0x4D3C00}


class Canvas:
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.px = [["."] * w for _ in range(h)]

    def disc(self, cx, cy, r, ch):
        for y in range(self.h):
            for x in range(self.w):
                if (x + 0.5 - cx) ** 2 + (y + 0.5 - cy) ** 2 <= r * r:
                    self.px[y][x] = ch
        return self

    def dots(self, points, ch):
        for x, y in points:
            self.px[y][x] = ch
        return self

    def rows(self):
        return ["".join(r) for r in self.px]


def sun(ring):
    """A 5x5 disc, alone or with a ring of eight aura pixels in the shade `ring`: beside its four sides
    and at its four corners. The three frames breathe on the clock - dark, faint, bright, faint. Rays
    in the disc's own yellow merged with it into a diamond, and two pixels of aura would not fit above
    the disc in eight rows; a one-pixel ring in two dim shades reads as a glow, not as a shape."""
    dots = [(3, 0), (3, 6), (0, 3), (6, 3), (1, 1), (5, 1), (1, 5), (5, 5)] if ring else []
    return Canvas(7, 7).disc(3.5, 3.5, 2.5, "Y").dots(dots, ring).rows()


def moon():
    """A 7x7 disc with a larger disc taken out of its right side."""
    return Canvas(7, 7).disc(3.5, 3.5, 3.2, "P").disc(6.3, 3.5, 3.6, ".").rows()


# The silhouette of the Hub icon "cloud" less one of its two full rows: one bump, rounded underneath.
CLOUD = ["..##...",
         ".#####.",
         "#######",
         ".#####."]


def stretch(rows, at, by):
    """The rows with column `at` repeated `by` more times."""
    return [r[:at] + r[at] * by + r[at:] for r in rows]


def tint(rows, fill, shade):
    """'#' becomes `fill`, except the lowest pixel of each column, which becomes `shade`."""
    out = [list(r) for r in rows]
    for x in range(len(rows[0])):
        lit = [y for y in range(len(rows)) if rows[y][x] == "#"]
        for y in lit:
            out[y][x] = shade if y == lit[-1] else fill
    return ["".join(r) for r in out]


# the wide cloud: the silhouette widened on both sides of the bump, so the bump stays near the middle
WIDE = stretch(stretch(CLOUD, 5, 2), 1, 1)
BOLT = ["..Z", ".ZZ", ".Z."]

# The glyphs the pages use, from the firmware's default font (assets/fonts/awtrix.bdf in the
# awtrix-ng repository): width, rows above the baseline, rows top to bottom. The script draws
# them itself where a wipe sprite passes, since the firmware cannot clip text.
GLYPHS = {"0": (3, 0, "###|#.#|#.#|#.#|###"), "1": (3, 0, ".#.|##.|.#.|.#.|###"), "2": (3, 0, "###|..#|###|#..|###"),
          "3": (3, 0, "###|..#|###|..#|###"), "4": (3, 0, "#.#|#.#|###|..#|..#"), "5": (3, 0, "###|#..|###|..#|###"),
          "6": (3, 0, "###|#..|###|#.#|###"), "7": (3, 0, "###|..#|..#|..#|..#"), "8": (3, 0, "###|#.#|###|#.#|###"),
          "9": (3, 0, "###|#.#|###|..#|###"), ":": (1, 1, "#|.|#"), "-": (3, 2, "###"),
          "F": (3, 0, "###|#..|###|#..|#.."), ".": (1, 0, "#")}

ELEMENTS = [
    ("sun", [sun(None), sun("a"), sun("A")]),
    ("moon", [moon()]),
    ("cloud", [tint(WIDE, "L", "M")]),
    ("storm", [tint(WIDE, "E", "D")]),
    ("flash", [tint(WIDE, "W", "L")]),
    ("fog", [tint(WIDE, "G", "g")]),
    ("back", [tint(CLOUD, "D", "D")]),
    ("bolt", [BOLT]),
]


def berry_list(rows):
    return "[" + ", ".join(f'"{r}"' for r in rows) + "]"


def module():
    """The art module: a map of the palette, every element (one frame or a list of frames) and the font."""
    lines = ["# @module",
             "# @desc Weather scene art of the clock: palette, elements as rows of palette letters, glyph font. "
             "Generated by art/generate, do not edit.",
             "return {",
             ' "wpal": {' + ", ".join(f'"{k}": 0x{v:06X}' for k, v in PALETTE.items()) + "},"]
    for name, frames in ELEMENTS:
        if len(frames) == 1:
            lines.append(f' "{name}": {berry_list(frames[0])},')
        else:
            lines.append(f' "{name}": [' + ", ".join(berry_list(f) for f in frames) + "],")
    glyphs = ", ".join(f'"{ch}": [{w}, {yo}, "{rows}"]' for ch, (w, yo, rows) in GLYPHS.items())
    lines.append(' "font": {' + glyphs + "}}")
    return "\n".join(lines) + "\n"


def block():
    names = ["wpal"] + [name for name, _ in ELEMENTS] + ["font"]
    return "\n".join([BEGIN] + [f'    self.{n} = art["{n}"]' for n in names if n != "font"] + [END]) + "\n"


def preview():
    scale, gap, label = 14, 2, 70
    font = ImageFont.truetype("/System/Library/Fonts/Menlo.ttc", 13)
    row_h = max(len(rows) for _, frames in ELEMENTS for rows in frames) * scale + 12
    width = label + max(sum(len(rows[0]) * scale + 12 for rows in frames) for _, frames in ELEMENTS)
    img = Image.new("RGB", (width, len(ELEMENTS) * row_h + 8), (30, 30, 30))
    d = ImageDraw.Draw(img)
    for i, (name, frames) in enumerate(ELEMENTS):
        y0 = 8 + i * row_h
        d.text((6, y0 + 4), name, fill=(220, 220, 220), font=font)
        x0 = label
        for rows in frames:
            for y, row in enumerate(rows):
                for x, ch in enumerate(row):
                    col = (18, 18, 18) if ch == "." else tuple((PALETTE[ch] >> s) & 255 for s in (16, 8, 0))
                    px, py = x0 + x * scale, y0 + y * scale
                    d.rectangle([px, py, px + scale - gap - 1, py + scale - gap - 1], fill=col)
            x0 += len(rows[0]) * scale + 12
    img.save(PREVIEW)
    return PREVIEW


def write(text):
    src = SCRIPT.read_text()
    if BEGIN not in src or END not in src:
        sys.exit(f"{SCRIPT}: the art markers are missing; nothing written")
    a, b = src.index(BEGIN), src.index(END) + len(END) + 1
    SCRIPT.write_text(src[:a] + text + src[b:])


if __name__ == "__main__":
    print(preview())
    if "--write" in sys.argv:
        write(block())
        MODULE.write_text(module())
        print(f"{SCRIPT.relative_to(HERE.parent)} and {MODULE.relative_to(HERE.parent)} updated")
    else:
        print(module(), end="")
